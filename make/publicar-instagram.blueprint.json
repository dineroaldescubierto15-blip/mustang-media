{
  "name": "Mustang Emotion – Publicar a Instagram + clics de Telegram",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": null,
        "maxResults": 1
      },
      "mapper": {}
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "routes": [
        {
          "flow": [
            {
              "id": 20,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "url": "https://api.github.com/repos/dineroaldescubierto15-blip/mustang-media/dispatches",
                "serializeUrl": false,
                "method": "post",
                "headers": [
                  {
                    "name": "Authorization",
                    "value": "Bearer ENGANXA_AQUI_EL_TOKEN_DE_GITHUB"
                  },
                  {
                    "name": "Accept",
                    "value": "application/vnd.github+json"
                  },
                  {
                    "name": "X-GitHub-Api-Version",
                    "value": "2022-11-28"
                  },
                  {
                    "name": "User-Agent",
                    "value": "mustangemotion-make"
                  }
                ],
                "qs": [],
                "bodyType": "raw",
                "contentType": "application/json",
                "data": "{\"event_type\": \"telegram\", \"client_payload\": {\"cb_id\": \"{{1.callback_query.id}}\", \"cb_data\": \"{{1.callback_query.data}}\", \"cb_chat\": \"{{1.callback_query.message.chat.id}}\", \"cb_msg\": \"{{1.callback_query.message.message_id}}\", \"text\": \"{{encodeURL(1.message.text)}}\", \"chat\": \"{{1.message.chat.id}}\", \"chat_type\": \"{{1.message.chat.type}}\"}}",
                "parseResponse": false,
                "timeout": "60",
                "shareCookies": false,
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false
              },
              "filter": {
                "name": "Telegram (clic o ordre)",
                "conditions": [
                  [
                    {
                      "a": "{{1.update_id}}",
                      "o": "exist"
                    },
                    {
                      "a": "{{1.callback_query.data}}",
                      "o": "exist"
                    }
                  ],
                  [
                    {
                      "a": "{{1.update_id}}",
                      "o": "exist"
                    },
                    {
                      "a": "{{1.message.text}}",
                      "b": "/",
                      "o": "text:startwith"
                    }
                  ]
                ]
              },
              "onerror": [
                {
                  "id": 21,
                  "module": "builtin:Ignore",
                  "version": 1,
                  "mapper": null
                }
              ]
            }
          ]
        },
        {
          "flow": [
            {
              "id": 3,
              "module": "instagram-business:CreateAReelPost",
              "version": 1,
              "filter": {
                "name": "Reel",
                "conditions": [
                  [
                    {
                      "a": "{{1.media_type}}",
                      "b": "REELS",
                      "o": "text:equal"
                    }
                  ]
                ]
              },
              "parameters": {
                "__IMTCONN__": null
              },
              "mapper": {
                "accountId": "",
                "video_url": "{{1.media_url}}",
                "caption": "{{1.caption}}",
                "share_to_feed": true,
                "thumb_offset": 2500
              },
              "onerror": [
                {
                  "id": 10,
                  "module": "gateway:WebhookRespond",
                  "version": 1,
                  "parameters": {},
                  "mapper": {
                    "status": 500,
                    "body": "{\"ok\": false, \"error\": \"{{error.message}}\"}",
                    "headers": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      }
                    ]
                  }
                },
                {
                  "id": 11,
                  "module": "builtin:Ignore",
                  "version": 1,
                  "mapper": null
                }
              ]
            },
            {
              "id": 4,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": 200,
                "body": "{\"ok\": true, \"post_id\": \"{{3.id}}\"}",
                "headers": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ]
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 5,
              "module": "instagram-business:CreatePostPhoto",
              "version": 1,
              "filter": {
                "name": "Foto",
                "conditions": [
                  [
                    {
                      "a": "{{1.media_type}}",
                      "b": "IMAGE",
                      "o": "text:equal"
                    }
                  ]
                ]
              },
              "parameters": {
                "__IMTCONN__": null
              },
              "mapper": {
                "accountId": "",
                "image_url": "{{1.media_url}}",
                "caption": "{{1.caption}}",
                "user_tags": [
                  {
                    "username": "{{1.author}}",
                    "x": 0.5,
                    "y": 0.5
                  }
                ]
              },
              "onerror": [
                {
                  "id": 12,
                  "module": "gateway:WebhookRespond",
                  "version": 1,
                  "parameters": {},
                  "mapper": {
                    "status": 500,
                    "body": "{\"ok\": false, \"error\": \"{{error.message}}\"}",
                    "headers": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      }
                    ]
                  }
                },
                {
                  "id": 13,
                  "module": "builtin:Ignore",
                  "version": 1,
                  "mapper": null
                }
              ]
            },
            {
              "id": 6,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": 200,
                "body": "{\"ok\": true, \"post_id\": \"{{5.id}}\"}",
                "headers": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false
    }
  }
}