{
  "name": "Mustang Emotion – Publicar a Instagram (webhook de GitHub)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": null,
        "maxResults": 1
      },
      "mapper": {}
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "routes": [
        {
          "flow": [
            {
              "id": 3,
              "module": "instagram-business:CreateAReelPost",
              "version": 1,
              "filter": {
                "name": "Reel",
                "conditions": [
                  [
                    {
                      "a": "{{1.media_type}}",
                      "b": "REELS",
                      "o": "text:equal"
                    }
                  ]
                ]
              },
              "parameters": {
                "__IMTCONN__": null
              },
              "mapper": {
                "accountId": "",
                "video_url": "{{1.media_url}}",
                "caption": "{{1.caption}}",
                "share_to_feed": true,
                "thumb_offset": 2500
              },
              "onerror": [
                {
                  "id": 10,
                  "module": "gateway:WebhookRespond",
                  "version": 1,
                  "parameters": {},
                  "mapper": {
                    "status": "500",
                    "body": "{\"ok\": false, \"error\": \"{{replace(error.message; \"\\\"\"; \"'\")}}\"}",
                    "headers": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      }
                    ]
                  }
                },
                {
                  "id": 11,
                  "module": "builtin:Ignore",
                  "version": 1,
                  "mapper": null
                }
              ]
            },
            {
              "id": 4,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": "200",
                "body": "{\"ok\": true, \"post_id\": \"{{3.id}}\"}",
                "headers": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ]
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 5,
              "module": "instagram-business:CreatePostPhoto",
              "version": 1,
              "filter": {
                "name": "Foto",
                "conditions": [
                  [
                    {
                      "a": "{{1.media_type}}",
                      "b": "IMAGE",
                      "o": "text:equal"
                    }
                  ]
                ]
              },
              "parameters": {
                "__IMTCONN__": null
              },
              "mapper": {
                "accountId": "",
                "image_url": "{{1.media_url}}",
                "caption": "{{1.caption}}",
                "user_tags": [
                  {
                    "username": "{{1.author}}",
                    "x": 0.5,
                    "y": 0.5
                  }
                ]
              },
              "onerror": [
                {
                  "id": 12,
                  "module": "gateway:WebhookRespond",
                  "version": 1,
                  "parameters": {},
                  "mapper": {
                    "status": "500",
                    "body": "{\"ok\": false, \"error\": \"{{replace(error.message; \"\\\"\"; \"'\")}}\"}",
                    "headers": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      }
                    ]
                  }
                },
                {
                  "id": 13,
                  "module": "builtin:Ignore",
                  "version": 1,
                  "mapper": null
                }
              ]
            },
            {
              "id": 6,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": "200",
                "body": "{\"ok\": true, \"post_id\": \"{{5.id}}\"}",
                "headers": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false
    }
  }
}